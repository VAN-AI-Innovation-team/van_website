{
  "name": "van-official-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:share": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "build:pages": "cross-env SITE_URL=https://van-ai-innovation.github.io BASE_PATH=/van_website astro build",
    "lint": "oxlint astro.config.mjs src/data src/pages",
    "preview": "astro preview",
    "check": "npm run lint && npm run build"
  },
  "dependencies": {
    "astro": "7.2.6"
  },
  "devDependencies": {
    "cross-env": "10.1.0",
    "oxlint": "^1.75.0"
  }
}
