{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/apply", "destination": "/ko/apply/", "permanent": false },
    { "source": "/apply/", "destination": "/ko/apply/", "permanent": false },
    { "source": "/support", "destination": "/ko/support/", "permanent": false },
    { "source": "/support/", "destination": "/ko/support/", "permanent": false }
  ]
}
