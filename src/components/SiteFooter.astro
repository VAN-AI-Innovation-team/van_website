---
import { basePath, content, homeSectionPath, routePath } from '../data/site.js'

const { lang } = Astro.props
const copy = content[lang]
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <img src={basePath('/assets/logo_white_hd.png')} alt="VAN" width="360" height="113" loading="lazy" />
      <p>{copy.footer.line}</p>
    </div>
    <nav aria-label="Footer navigation">
      <a href={homeSectionPath(lang, 'about')}>{copy.nav.about}</a>
      <a href={homeSectionPath(lang, 'activities')}>{copy.nav.activities}</a>
      <a href={basePath(routePath(lang, 'archive'))}>{copy.nav.archive}</a>
      <a href={basePath(routePath(lang, 'apply'))}>{copy.nav.apply}</a>
      <a href={basePath(routePath(lang, 'support'))}>{copy.nav.support}</a>
      <a href={homeSectionPath(lang, 'contact')}>{copy.nav.contact}</a>
    </nav>
  </div>
  <div class="footer-bottom">
    <span>© {new Date().getFullYear()} {copy.footer.copyright}</span>
    <span>EST. SEOUL · YONSEI · KOREA</span>
  </div>
</footer>
