---
/** 서브 페이지 공통 히어로. HOME의 풀스크린 히어로보다 낮고 조용한 변주. */
const { eyebrow, title, lead } = Astro.props

// 금빛 입자. 난수 대신 고정 좌표를 쓴다 — 빌드마다 결과가 흔들리면
// 정적 산출물의 diff가 매번 바뀌어 리뷰가 어려워진다.
const particles = [
  { x: 12, y: 72, size: 3, duration: 15, delay: 0 },
  { x: 26, y: 88, size: 2, duration: 18, delay: 2.4 },
  { x: 44, y: 64, size: 4, duration: 13, delay: 4.1 },
  { x: 61, y: 92, size: 2, duration: 17, delay: 1.2 },
  { x: 78, y: 70, size: 3, duration: 14, delay: 5.6 },
  { x: 91, y: 84, size: 2, duration: 19, delay: 3.3 },
]
---

<header class="page-hero">
  <div class="page-hero__aurora" aria-hidden="true"></div>
  <div class="hero-particles" aria-hidden="true">
    {particles.map((p) => (
      <i style={`--px:${p.x}%; --py:${p.y}%; --ps:${p.size}px; --pd:${p.duration}s; --pl:${p.delay}s`}></i>
    ))}
  </div>
  <div class="container page-hero__content">
    <p class="eyebrow">{eyebrow}</p>
    <h1 data-split>{title}</h1>
    {lead && <p class="page-hero__lead">{lead}</p>}
    <div class="page-hero__rule" aria-hidden="true"><i></i><span>◆</span></div>
  </div>
</header>
