---
import { basePath, content, homeSectionPath, navItems, routePath } from '../data/site.js'

const { lang, currentKey, currentSlug } = Astro.props
const copy = content[lang]
const otherLang = lang === 'ko' ? 'en' : 'ko'
const languageLabel = otherLang === 'ko' ? 'KO' : 'EN'
const hrefFor = (item) => item.slug ? basePath(routePath(lang, item.slug)) : homeSectionPath(lang, item.section)
---

<header class="site-header">
  <a class="skip-link" href="#main-content">{copy.skip}</a>
  <div class="header-inner">
    <a class="brand" href={basePath(routePath(lang))} aria-label="VAN home">
      <img src={basePath('/assets/logo_dark.png')} alt="" width="190" height="68" />
      <span>VERITAS ACADEMIAE NEXUS</span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      {navItems.map((item) => (
        <a
          href={hrefFor(item)}
          data-nav-section={currentKey === 'home' && item.section ? item.section : undefined}
          aria-current={currentKey === item.key ? 'page' : undefined}
        >{copy.nav[item.key]}</a>
      ))}
    </nav>

    <a class="language-link" href={basePath(routePath(otherLang, currentSlug))} hreflang={otherLang}>{languageLabel}</a>

    <details class="mobile-menu">
      <summary aria-label={copy.menu}><span>{copy.menu}</span><i aria-hidden="true"></i></summary>
      <nav aria-label="Mobile navigation">
        <div class="mobile-menu__top"><span>VERITAS ACADEMIAE NEXUS</span><a href={basePath(routePath(otherLang, currentSlug))} hreflang={otherLang}>{languageLabel}</a></div>
        {navItems.map((item, index) => (
          <a href={hrefFor(item)} aria-current={currentKey === item.key ? 'page' : undefined}><span>{String(index + 1).padStart(2, '0')}</span>{copy.nav[item.key]}</a>
        ))}
      </nav>
    </details>
  </div>
</header>
