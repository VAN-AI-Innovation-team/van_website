---
const { edition, href } = Astro.props
---

<article class="conference-archive-card">
  <div class="conference-archive-card__year" aria-hidden="true">{edition.year}</div>
  <div class="conference-archive-card__content">
    <div class="conference-archive-card__meta">
      <span>VAN CONFERENCE</span>
      <small>{edition.statusLabel}</small>
    </div>
    <h2>{edition.archive.title}</h2>
    <p>{edition.archive.summary}</p>
    <a href={href} aria-label={edition.archive.linkLabel}>{edition.archive.linkLabel}<span aria-hidden="true">↗</span></a>
  </div>
</article>

<style>
  .conference-archive-card {
    display: grid;
    grid-template-columns: minmax(180px, 0.42fr) minmax(0, 1fr);
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--line-light);
    border-radius: 10px;
    background: #fff;
    box-shadow: 0 16px 40px rgba(17, 46, 70, 0.06);
  }

  .conference-archive-card__year {
    display: grid;
    min-height: 310px;
    padding: 1.5rem;
    place-items: center;
    color: #fff;
    background: linear-gradient(145deg, #315f80, #0b2037);
    font-size: clamp(3rem, 7vw, 6rem);
    font-weight: 760;
    letter-spacing: -0.06em;
  }

  .conference-archive-card__content {
    display: flex;
    min-width: 0;
    padding: clamp(1.5rem, 4vw, 3rem);
    flex-direction: column;
    justify-content: center;
  }

  .conference-archive-card__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    color: #52748d;
    font-size: 0.68rem;
    font-weight: 760;
    letter-spacing: 0.08em;
  }

  .conference-archive-card__meta small {
    padding: 0.28rem 0.5rem;
    border-radius: 999px;
    color: #315f80;
    background: #e4eff5;
    font-size: 0.62rem;
    font-weight: 800;
  }

  .conference-archive-card h2 {
    margin-top: 1rem;
    color: #10283d;
    font-size: clamp(1.8rem, 4vw, 3.2rem);
  }

  .conference-archive-card p {
    max-width: 700px;
    margin-top: 1rem;
    color: #5d7180;
  }

  .conference-archive-card a {
    display: inline-flex;
    width: fit-content;
    min-height: 44px;
    margin-top: 1.7rem;
    align-items: center;
    gap: 0.6rem;
    color: #315f80;
    font-size: 0.78rem;
    font-weight: 760;
  }

  @media (max-width: 760px) {
    .conference-archive-card {
      grid-template-columns: 1fr;
    }

    .conference-archive-card__year {
      min-height: 150px;
    }
  }
</style>
