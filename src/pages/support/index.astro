---
/**
 * 언어 접두사가 없는 짧은 주소. QR·포스터·구두 안내용 진입점입니다.
 * /support/ 로 들어오면 항상 한국어 페이지로 보냅니다.
 * 지연 없는 즉시 이동으로 처리하는 이유는 /apply/index.astro 주석을 참고하세요.
 */
const target = '/ko/support/'
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={`https://www.veritasvan.org${target}`} />
    <title>후원 안내로 이동합니다</title>
    <script is:inline define:vars={{ target }}>
      window.location.replace(target)
    </script>
  </head>
  <body>
    <p>페이지로 이동하고 있습니다. 자동으로 넘어가지 않으면 <a href={target}>후원 안내 열기</a>를 눌러주세요.</p>
  </body>
</html>
