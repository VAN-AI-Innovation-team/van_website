---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import PageHero from '../../../components/PageHero.astro'
import Marquee from '../../../components/Marquee.astro'
import { supportPage } from '../../../data/pages.js'
import { basePath, content, languages, routePath } from '../../../data/site.js'

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }))
}

const lang = Astro.params.lang
const copy = content[lang]
const page = supportPage[lang]
const support = copy.home.support
const contact = copy.home.contact
const [title, description] = copy.meta.support
---

<BaseLayout lang={lang} pageKey="support" slug="support" title={title} description={description}>
  <PageHero eyebrow={page.eyebrow} title={page.title} lead={page.lead} />

  <section class="home-section home-section--paper">
    <div class="container">
      <header class="section-intro" data-ghost={page.usageNumber} data-reveal="up">
        <div class="section-intro__band">
          <span class="section-number">{page.usageNumber}</span>
          <p>{page.usageSubtitle}</p>
          <i aria-hidden="true"></i>
        </div>
        <h2 data-split>{page.usageTitle}</h2>
      </header>
      <div class="info-grid" data-reveal-group>
        {page.usage.map((item, index) => (
          <article class="info-card" data-reveal="rise" data-tilt="4">
            <span class="info-card__index">{String(index + 1).padStart(2, '0')}</span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="home-section home-section--mist">
    <div class="container">
      <header class="section-intro" data-ghost={page.waysNumber} data-reveal="up">
        <div class="section-intro__band">
          <span class="section-number">{page.waysNumber}</span>
          <p>{page.waysSubtitle}</p>
          <i aria-hidden="true"></i>
        </div>
        <h2 data-split>{page.waysTitle}</h2>
      </header>
      <p class="section-lead section-lead--wide" data-reveal="up">{page.waysLead}</p>

      <div class="way-list" data-reveal-group>
        {page.ways.map((way, index) => (
          <article class="way-card" data-reveal="rise" data-tilt="4">
            <header class="way-card__head">
              <span class="way-card__index">{String(index + 1).padStart(2, '0')}</span>
              <span class="way-card__tag">{way.tag}</span>
            </header>
            <h3>{way.title}</h3>
            <p class="way-card__body">{way.body}</p>

            {way.tiers && (
              <ul class="way-card__tiers">
                {way.tiers.map((tier) => <li>{tier}</li>)}
              </ul>
            )}

            {way.points && (
              <ul class="way-card__points">
                {way.points.map((point) => <li>{point}</li>)}
              </ul>
            )}

            {way.note && <p class="way-card__note">{way.note}</p>}

            {way.fundingUrl && (
              <a class="way-card__cta" href={way.fundingUrl} target="_blank" rel="noopener noreferrer" data-magnetic="8">
                {way.fundingLabel}<span aria-hidden="true">→</span>
              </a>
            )}

            {way.linkSlug && (
              <a class="inline-link" href={basePath(routePath(lang, `archive/${way.linkSlug}`))} data-magnetic="8">
                {way.linkLabel}<span aria-hidden="true">→</span>
              </a>
            )}
          </article>
        ))}
      </div>

      {/* 담당자를 맨 위에 두어 누구에게 연락하는지 먼저 보이게 한다. */}
      <div class="way-contact" data-reveal="up">
        <div class="way-contact__head">
          <p class="way-contact__manager">{contact.manager}</p>
          <h3>{page.waysContactTitle}</h3>
          <p>{page.waysContactLead}</p>
        </div>
        <div class="way-contact__actions">
          <a class="button-link" href={`tel:${contact.phone.replace(/-/g, '')}`}>{contact.phone}<span aria-hidden="true">→</span></a>
          <a class="button-link" href={`mailto:${contact.email}`}>{contact.email}<span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="home-section home-section--paper">
    <div class="container">
      <header class="section-intro" data-ghost={page.formNumber} data-reveal="up">
        <div class="section-intro__band">
          <span class="section-number">{page.formNumber}</span>
          <p>{page.formSubtitle}</p>
          <i aria-hidden="true"></i>
        </div>
        <h2 data-split>{page.formTitle}</h2>
      </header>
      <p class="section-lead section-lead--wide" data-reveal="up">{page.formLead}</p>

      {/*
        정적 사이트라 서버가 없다. 외부 폼 서비스에 계정을 만들지 않고 처리하기 위해
        입력값으로 메일 본문을 조립해 메일 앱으로 넘기고, 복사 버튼도 함께 제공한다.
        조립과 검증은 interactions.js 의 setupSupportForm 이 담당한다.
      */}
      <form
        class="donor-form"
        data-support-form
        data-mail-to={contact.email}
        data-subject={page.formSubject}
        data-incomplete={page.formIncomplete}
        data-copy-label={page.formCopy}
        data-copied-label={page.formCopied}
        data-reveal="up"
        novalidate
      >
        <div class="donor-form__grid">
          <label>
            <span>{page.formLabels.name} <i>{page.formLabels.required}</i></span>
            <input type="text" name="name" autocomplete="name" required />
          </label>
          <label>
            <span>{page.formLabels.phone} <i>{page.formLabels.required}</i></span>
            <input type="tel" name="phone" autocomplete="tel" required />
          </label>
          <label>
            <span>{page.formLabels.email} <i>{page.formLabels.required}</i></span>
            <input type="email" name="email" autocomplete="email" required />
          </label>
          <label>
            <span>{page.formLabels.amount}</span>
            <select name="amount">
              {page.formAmounts.map((amount) => <option value={amount}>{amount}</option>)}
            </select>
          </label>
          <label class="donor-form__custom" data-amount-custom hidden>
            <span>{page.formLabels.amountCustom}</span>
            <input type="text" name="amountCustom" />
          </label>
          <label class="donor-form__wide">
            <span>{page.formLabels.message}</span>
            <textarea name="message" rows="3"></textarea>
          </label>
        </div>

        <label class="donor-form__consent">
          <input type="checkbox" name="consent" required />
          <span>{page.formLabels.consent}</span>
        </label>

        <div class="donor-form__actions">
          <button class="cta-button" type="submit" data-magnetic="10">{page.formSubmit}<span aria-hidden="true">→</span></button>
          <button class="button-link" type="button" data-support-copy>{page.formCopy}</button>
        </div>

        <p class="donor-form__hint">{page.formHint}</p>
        <p class="donor-form__error" data-support-error role="alert" hidden></p>
      </form>
    </div>
  </section>

  <Marquee items={copy.ticker} display />

  <section class="home-section home-section--sand">
    <div class="container support-layout">
      <div data-reveal="left">
        <span class="section-number">{page.accountNumber}</span>
        <p class="eyebrow">{page.accountSubtitle}</p>
        <h2 data-split>{page.accountTitle}</h2>
        <p>{page.accountLead}</p>
        <a class="inline-link" href={basePath(routePath(lang))} data-magnetic="8">{page.homeLink}<span aria-hidden="true">→</span></a>
      </div>
      <article class="donation-card" data-reveal="right" data-spotlight data-tilt="5">
        <div class="donation-card__top"><span>{copy.common.donationAccount}</span><i aria-hidden="true"></i></div>
        <dl>
          <div><dt>{copy.common.bank}</dt><dd>{support.bank}</dd></div>
          <div>
            <dt>{copy.common.accountNumber}</dt>
            <dd>
              <strong>{support.account}</strong>
              <button type="button" data-copy-account={support.account} data-copy-label={copy.common.copy} data-copied-label={copy.common.copied}>{copy.common.copy}</button>
            </dd>
          </div>
          <div><dt>{copy.common.holder}</dt><dd>{support.holder}</dd></div>
        </dl>
        <div class="donation-card__guide">
          <p>{support.guide}</p>
          <span>{support.example}</span>
        </div>
      </article>
    </div>
  </section>

  <section class="contact-section">
    <div class="container contact-section__grid">
      <div data-reveal="left">
        <span class="section-number">{page.contactNumber}</span>
        <p class="eyebrow">{page.contactSubtitle}</p>
        <h2 data-split>{page.contactTitle}</h2>
        <p class="section-lead section-lead--light">{page.contactLead}</p>
      </div>
      <div class="contact-list" data-reveal-group>
        <a href={contact.instagramUrl} target="_blank" rel="noopener noreferrer" data-reveal="fade">
          <span>{copy.common.instagram}</span><strong>{contact.instagram}</strong>
        </a>
        <div data-reveal="fade">
          <span>{copy.common.phone}</span><strong>{contact.phone}</strong><small>{contact.manager}</small>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
