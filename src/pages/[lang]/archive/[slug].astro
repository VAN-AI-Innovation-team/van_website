---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { archiveItems, archiveLabels } from '../../../data/activityArchive.js'
import { basePath, languages, routePath } from '../../../data/site.js'

export function getStaticPaths() {
  return languages.flatMap((lang) => archiveItems[lang].map((post) => ({
    params: { lang, slug: post.slug },
    props: { post },
  })))
}

const lang = Astro.params.lang
const { post } = Astro.props
const labels = archiveLabels[lang]
const pageSlug = `archive/${post.slug}`
const title = `${post.title} | VAN Archive`
const description = post.excerpt
const archiveLink = basePath(routePath(lang, 'archive'))
const asset = (path) => basePath(path)
---

<BaseLayout lang={lang} pageKey="archive" slug={pageSlug} title={title} description={description}>
  <article class="archive-article">
    <header class="archive-article-hero">
      <div class="container">
        <a class="archive-back-link" href={archiveLink}><span aria-hidden="true">←</span>{labels.back}</a>
        <p class="eyebrow">{post.category} · {labels.record}</p>
        <h1>{post.title}</h1>
        <p>{post.excerpt}</p>
      </div>
    </header>
    <section class="home-section home-section--paper">
      <div class="container archive-article-layout">
        {post.cover && <figure class="archive-article-cover" data-reveal="wipe"><img src={asset(post.cover)} alt={post.coverAlt} /></figure>}
        <div class="archive-article-body" data-reveal-group>
          {post.body.map((paragraph) => <p data-reveal="up">{paragraph}</p>)}
        </div>

        {/* 펀딩·외부 안내 링크. 본문 바로 뒤에 두어 눌러서 이동할 수 있게 한다. */}
        {post.link && (
          <div class="archive-cta" data-reveal="up">
            <a class="button" href={post.link.url} target="_blank" rel="noopener noreferrer" data-magnetic="10">
              {post.link.label}<span aria-hidden="true">→</span>
            </a>
            {post.link.note && <p>{post.link.note}</p>}
          </div>
        )}

        {/* 표지·내지 시안처럼 비율이 서로 다른 이미지는 잘라내지 않고 설명과 함께 세로로 쌓는다. */}
        {post.figures && (
          <div class="archive-figures" data-reveal-group>
            {post.figures.map((item) => (
              <figure data-reveal="wipe">
                <img src={asset(item.image)} alt={item.alt} loading="lazy" />
                {item.caption && <figcaption>{item.caption}</figcaption>}
              </figure>
            ))}
          </div>
        )}

        {post.spec && (
          <section class="archive-spec" data-reveal="up">
            <h2>{post.spec.title}</h2>
            <dl>
              {post.spec.items.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
            </dl>
          </section>
        )}

        {post.contents && (
          <section class="archive-contents" data-reveal="up">
            <h2>{post.contents.title}</h2>
            {post.contents.note && <p class="archive-contents__note">{post.contents.note}</p>}
            <div class="archive-contents__parts">
              {post.contents.parts.map((part) => (
                <div>
                  <h3>{part.title}</h3>
                  <ul>{part.items.map((item) => <li>{item}</li>)}</ul>
                </div>
              ))}
            </div>
          </section>
        )}

        {post.gallery && (
          <div class="archive-article-gallery" data-reveal-group>
            {post.gallery.map((item) => <img data-reveal="wipe" src={asset(item.image)} alt={item.alt} loading="lazy" />)}
          </div>
        )}
      </div>
    </section>
    <section class="archive-next">
      <div class="container" data-reveal="up"><p class="eyebrow">VAN ARCHIVE</p><h2>{labels.related}</h2><a class="button-link" href={archiveLink}>{labels.back}<span aria-hidden="true">→</span></a></div>
    </section>
  </article>
</BaseLayout>
