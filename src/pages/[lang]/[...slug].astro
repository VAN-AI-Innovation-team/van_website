---
import BaseLayout from '../../layouts/BaseLayout.astro'
import ConferenceArchiveCard from '../../components/ConferenceArchiveCard.astro'
import FaqList from '../../components/FaqList.astro'
import PartnerGrid from '../../components/PartnerGrid.astro'
import ProgrammeList from '../../components/ProgrammeList.astro'
import SpeakerCard from '../../components/SpeakerCard.astro'
import { archiveCategories, archiveItems, archiveLabels } from '../../data/archive.js'
import {
  getConferenceEdition,
  getConferenceEditionSummaries,
  getConferenceStatusLabel,
} from '../../data/conferenceEditions.js'
import {
  basePath,
  content,
  languages,
  routeBySlug,
  routeEntries,
  routePath,
} from '../../data/conference.js'

export function getStaticPaths() {
  return languages.flatMap((lang) => routeEntries.map(({ slug }) => ({
    params: { lang, slug: slug || undefined },
  })))
}

const lang = Astro.params.lang
const slug = Astro.params.slug || ''
const route = routeBySlug[slug]
const pageKey = route.key
const copy = content[lang]
const conferenceEdition = route.kind === 'edition' ? getConferenceEdition(route.year, lang) : null
const page = conferenceEdition || copy[pageKey]
const [title, description] = conferenceEdition
  ? [conferenceEdition.meta.title, conferenceEdition.meta.description]
  : copy.meta[pageKey]
const navKey = route.navKey || pageKey
const link = (target) => basePath(routePath(lang, target))
const conferenceSummaries = getConferenceEditionSummaries(lang)
const currentConference = conferenceSummaries.find((edition) => edition.publicationStatus !== 'archived') || conferenceSummaries[0]
const currentFactValue = (id) => {
  const fact = currentConference?.facts.find((item) => item.id === id)
  return fact?.status === 'confirmed' && fact.value
    ? fact.value
    : currentConference?.statusLabel || copy.common.pending
}
const homeUpdates = currentConference
  ? [
      ['CONFERENCE', currentConference.archive.title, currentConference.archive.summary, `conference/${currentConference.slug}`],
      ...copy.home.updates,
    ]
  : copy.home.updates
const archiveCopy = archiveLabels[lang]
const archivePosts = archiveItems[lang]
const formatArchiveDate = (date) => lang === 'ko' ? date.replaceAll('-', '.') : date
---

<BaseLayout
  lang={lang}
  pageKey={pageKey}
  navKey={navKey}
  slug={slug}
  title={title}
  description={description}
  structuredEvent={conferenceEdition?.structuredEvent}
>
  {pageKey === 'home' && (
    <>
      <section class="van-hero" style={`--conference-hero-image: url(${basePath('/conference-hero.jpg')})`}>
        <div class="van-hero-frame" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
        <div class="container van-hero-inner">
          <div class="van-emblem" aria-label="VAN, Veritas Academiae Nexus">
            <span class="van-emblem-kicker">CURRENT EDITION</span>
            <strong>{currentConference?.year || 'VAN'}</strong>
            <span class="van-emblem-motto">VAN CONFERENCE</span>
          </div>
          <div class="van-hero-copy">
            <p class="eyebrow eyebrow--accent">{page.eyebrow}</p>
            <h1>{page.title}</h1>
            <p class="hero-lead">{page.lead}</p>
            {currentConference?.theme && (
              <p class="current-theme">
                <span>{currentConference.theme.label}</span>
                <strong>{currentConference.theme.title}</strong>
                <small>{currentConference.statusLabel}</small>
              </p>
            )}
            <div class="button-row">
              <a class="button button--accent" href={link(currentConference ? `conference/${currentConference.slug}` : 'conference')}>{copy.common.details}<span aria-hidden="true">↗</span></a>
              <a class="button button--ghost" href={link('application')}>{copy.common.apply}</a>
            </div>
            <p class="hero-note"><span aria-hidden="true"></span>{page.note}</p>
          </div>
        </div>
        <div class="container hero-index" aria-label={lang === 'ko' ? '현재 컨퍼런스 주요 정보' : 'Current conference overview'}>
          <div><span>EDITION</span><strong>{currentConference?.year || '—'}</strong></div>
          <div><span>STATUS</span><strong>{currentConference?.statusLabel || copy.common.pending}</strong></div>
          <div><span>DATE</span><strong>{currentFactValue('date')}</strong></div>
          <div><span>VENUE</span><strong>{currentFactValue('venue')}</strong></div>
        </div>
      </section>

      {currentConference?.stats && (
        <section class="conference-stat-strip" aria-labelledby="conference-stats-title">
          <div class="container conference-stat-heading">
            <div>
              <p class="eyebrow">CONFERENCE 2026</p>
              <h2 id="conference-stats-title">{currentConference.stats.title}</h2>
            </div>
            <p>{currentConference.stats.lead}</p>
          </div>
          <dl class="container conference-stat-grid">
            {currentConference.stats.items.map((item) => (
              <div>
                <dt>{item.label}</dt>
                <dd>{item.status === 'confirmed' && item.value
                  ? item.value
                  : getConferenceStatusLabel(lang, item.status)}</dd>
              </div>
            ))}
          </dl>
        </section>
      )}

      <section class="section section--paper">
        <div class="container statement-grid">
          <p class="section-number">I / ABOUT THE CONFERENCE</p>
          <div>
            <h2>{page.statementTitle}</h2>
            <p class="section-lead">{page.statementBody}</p>
            <a class="text-link text-link--dark" href={link('about')}>{lang === 'ko' ? '소개 자세히 보기' : 'Read our story'}<span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>

      <section class="section section--mist home-preview" aria-labelledby="home-preview-title">
        <div class="container section-heading section-heading--paper">
          <div>
            <p class="eyebrow">II / 2026 PREVIEW</p>
            <h2 id="home-preview-title">{page.previewTitle}</h2>
          </div>
          <p>{page.previewLead}</p>
        </div>
        <div class="container home-preview-grid">
          <article class="home-preview-card home-preview-card--speaker">
            <div class="home-preview-card__header">
              <span>SPEAKERS</span>
              <small>{currentConference?.statusLabel || copy.common.pending}</small>
            </div>
            <div class="home-preview-speaker-mark" aria-hidden="true"><span>VAN</span><b>?</b></div>
            <h3>{page.speakerPreviewTitle}</h3>
            <p>{page.speakerPreviewBody}</p>
            <a class="text-link text-link--dark" href={link(currentConference ? `conference/${currentConference.slug}` : 'conference')}>{copy.common.details}<span aria-hidden="true">↗</span></a>
          </article>
          <article class="home-preview-card home-preview-card--programme">
            <div class="home-preview-card__header">
              <span>PROGRAMME</span>
              <small>{currentConference?.statusLabel || copy.common.pending}</small>
            </div>
            <h3>{page.programmePreviewTitle}</h3>
            <p>{page.programmePreviewBody}</p>
            <ol class="home-programme-list">
              {currentConference?.programme.items.slice(0, 4).map((item, index) => (
                <li><span>{String(index + 1).padStart(2, '0')}</span><strong>{item.title}</strong><small>{getConferenceStatusLabel(lang, item.status)}</small></li>
              ))}
            </ol>
          </article>
        </div>
      </section>

      <section class="section section--ink">
        <div class="container section-heading">
          <div>
            <p class="eyebrow">III / ORGANIZING FLOW</p>
            <h2>{page.tracksTitle}</h2>
          </div>
          <p>{page.tracksLead}</p>
        </div>
        <div class="container track-grid">
          {page.tracks.map(([number, name, body]) => (
            <a class="track-card" href={link('departments')}>
              <span class="track-number">{number}</span>
              <h3>{name}</h3>
              <p>{body}</p>
              <span class="card-mark" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </section>

      <section class="section section--paper home-updates">
        <div class="container section-heading section-heading--paper">
          <div>
            <p class="eyebrow">IV / CURRENT & YEAR-ROUND</p>
            <h2>{page.updatesTitle}</h2>
          </div>
          <p>{page.updatesLead}</p>
        </div>
        <div class="container update-list">
          {homeUpdates.map(([category, title, body, target], index) => (
            <a href={link(target)}>
              <span class="update-index">{String(index + 1).padStart(2, '0')}</span>
              <span class="update-category">{category}</span>
              <span class="update-copy"><strong>{title}</strong><small>{body}</small></span>
              <span class="update-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
        <div class="container home-highlight">
          <div>
            <span>ARCHIVE</span>
            <small>{page.highlightStatus}</small>
          </div>
          <h3>{page.highlightTitle}</h3>
          <p>{page.highlightBody}</p>
          <a class="text-link text-link--dark" href={link('archive')}>{lang === 'ko' ? '연도별 기록 보기' : 'Explore the yearly archive'}<span aria-hidden="true">↗</span></a>
        </div>
      </section>

      <section class="section section--accent">
        <div class="container bridge">
          <div>
            <p class="eyebrow">V / YEAR-ROUND PARTNERSHIP</p>
            <h2>{page.bridgeTitle}</h2>
            <p>{page.bridgeBody}</p>
          </div>
          <a class="circle-link" href={link('partners')} aria-label={copy.common.partnership}><span>PARTNER</span><b aria-hidden="true">↗</b></a>
        </div>
      </section>
    </>
  )}

  {pageKey === 'conference' && (
    <>
      <section class="page-hero">
        <div class="container page-hero-grid">
          <div>
            <p class="eyebrow eyebrow--accent">{page.eyebrow}</p>
            <h1>{page.title}</h1>
          </div>
          <p class="page-lead">{page.lead}</p>
        </div>
      </section>
      <section class="section section--paper">
        <div class="container conference-edition-list">
          {conferenceSummaries.map((edition) => (
            <ConferenceArchiveCard edition={edition} href={link(`conference/${edition.slug}`)} />
          ))}
        </div>
      </section>
      <section class="section section--ink">
        <div class="container">
          <div class="section-heading"><div><p class="eyebrow">FORMAT</p><h2>{page.frameworkTitle}</h2></div></div>
          <div class="framework-grid">
            {page.framework.map(([title, body], index) => (
              <article><span>{String(index + 1).padStart(2, '0')}</span><h3>{title}</h3><p>{body}</p></article>
            ))}
          </div>
        </div>
      </section>
    </>
  )}

  {pageKey === 'conferenceEdition' && conferenceEdition && (
    <>
      <section class="event-hero">
        <div class="container event-hero-inner">
          <div>
            <p class="eyebrow eyebrow--accent">{conferenceEdition.hero.eyebrow}</p>
            <h1>{conferenceEdition.hero.title}</h1>
            <p class="hero-lead">{conferenceEdition.hero.lead}</p>
          </div>
          <div class="event-seal" aria-hidden="true"><span>VAN</span><b>{conferenceEdition.year}</b></div>
        </div>
      </section>
      <section class="event-facts">
        <div class="container facts-grid">
          {conferenceEdition.facts.map((fact) => (
            <div>
              <span>{fact.label}</span>
              <strong>{fact.status === 'confirmed' && fact.value
                ? fact.value
                : getConferenceStatusLabel(lang, fact.status)}</strong>
            </div>
          ))}
        </div>
      </section>
      <section class="section section--paper">
        <div class="container split-content">
          <p class="section-number">{conferenceEdition.overview.eyebrow}</p>
          <div><h2>{conferenceEdition.overview.title}</h2><p class="section-lead">{conferenceEdition.overview.body}</p></div>
        </div>
      </section>
      <section class="section section--paper conference-speakers">
        <div class="container section-heading section-heading--paper">
          <div><p class="eyebrow">{conferenceEdition.speakers.eyebrow}</p><h2>{conferenceEdition.speakers.title}</h2></div>
          <p>{conferenceEdition.speakers.lead}</p>
        </div>
        <div class="container conference-speaker-grid">
          {conferenceEdition.speakers.items.length > 0
            ? conferenceEdition.speakers.items.map((speaker) => (
                <SpeakerCard
                  speaker={speaker}
                  developmentLabel={conferenceEdition.statusLabel}
                  speakerLabel={conferenceEdition.speakers.title}
                  sessionLabel={conferenceEdition.speakers.sessionLabel}
                />
              ))
            : <SpeakerCard
                speaker={{ developmentMessage: conferenceEdition.speakers.empty }}
                developmentLabel={conferenceEdition.statusLabel}
                speakerLabel={conferenceEdition.speakers.title}
                sessionLabel={conferenceEdition.speakers.sessionLabel}
              />}
        </div>
      </section>
      <section class="section section--ink">
        <div class="container section-heading">
          <div><p class="eyebrow">{conferenceEdition.programme.eyebrow}</p><h2>{conferenceEdition.programme.title}</h2></div>
          <p>{conferenceEdition.programme.lead}</p>
        </div>
        <div class="container">
          <ProgrammeList
            sessions={conferenceEdition.programme.items}
            developmentLabel={conferenceEdition.statusLabel}
            speakersLabel={conferenceEdition.speakers.title}
          />
        </div>
      </section>
      <section class="section section--paper conference-venue">
        <div class="container split-content">
          <p class="section-number">{conferenceEdition.venue.eyebrow}</p>
          <article class="conference-venue-card">
            <span>{getConferenceStatusLabel(lang, conferenceEdition.venue.status)}</span>
            <h2>{conferenceEdition.venue.title}</h2>
            <p class="section-lead">{conferenceEdition.venue.lead}</p>
            <p>{conferenceEdition.venue.detail}</p>
          </article>
        </div>
      </section>
      <section class="section section--mist">
        <div class="container section-heading section-heading--paper">
          <div><p class="eyebrow">{conferenceEdition.partners.eyebrow}</p><h2>{conferenceEdition.partners.title}</h2></div>
          <p>{conferenceEdition.partners.lead}</p>
        </div>
        <div class="container">
          <PartnerGrid
            partners={conferenceEdition.partners.items}
            developmentLabel={conferenceEdition.statusLabel}
            emptyMessage={conferenceEdition.partners.empty}
          />
        </div>
      </section>
      <section class="section section--paper">
        <div class="container section-heading section-heading--paper">
          <div><p class="eyebrow">{conferenceEdition.faq.eyebrow}</p><h2>{conferenceEdition.faq.title}</h2></div>
          <p>{conferenceEdition.faq.lead}</p>
        </div>
        <div class="container">
          <FaqList items={conferenceEdition.faq.items} developmentLabel={conferenceEdition.statusLabel} />
        </div>
      </section>
      <section class="section section--mist conference-closing">
        <div class="container conference-closing-grid">
          <article class="conference-application-card">
            <p class="eyebrow">{conferenceEdition.application.eyebrow}</p>
            <h2>{conferenceEdition.application.title}</h2>
            <p>{conferenceEdition.application.body}</p>
            <a class="button button--dark" href={link('application')}>{conferenceEdition.application.linkLabel}</a>
          </article>
          <article class="conference-highlight-card">
            <div>
              <p class="eyebrow">{conferenceEdition.highlights.eyebrow}</p>
              <span>{getConferenceStatusLabel(lang, conferenceEdition.highlights.status)}</span>
            </div>
            <h2>{conferenceEdition.highlights.title}</h2>
            <p>{conferenceEdition.highlights.body}</p>
          </article>
        </div>
      </section>
    </>
  )}

  {pageKey === 'about' && (
    <>
      <section class="page-hero page-hero--orbital">
        <div class="container page-hero-grid">
          <div><p class="eyebrow eyebrow--accent">{page.eyebrow}</p><h1>{page.title}</h1></div>
          <p class="page-lead">{page.lead}</p>
        </div>
      </section>
      <section class="section section--paper">
        <div class="container about-purpose-grid">
          <article>
            <span>01</span>
            <p class="eyebrow">PURPOSE</p>
            <h2>{page.purposeTitle}</h2>
            <p>{page.purposeBody}</p>
          </article>
          <article>
            <span>02</span>
            <p class="eyebrow">CONNECTION</p>
            <h2>{page.agendaTitle}</h2>
            <p>{page.agendaBody}</p>
          </article>
        </div>
      </section>
      <section class="section section--paper">
        <div class="container"><p class="section-number">HOW WE WORK</p><h2 class="wide-title">{page.principlesTitle}</h2>
          <div class="principle-grid">
            {page.principles.map(([number, title, body]) => <article><span>{number}</span><h3>{title}</h3><p>{body}</p></article>)}
          </div>
        </div>
      </section>
      <section class="section section--mist">
        <div class="container section-heading section-heading--paper">
          <div><p class="eyebrow">WHO MEETS HERE</p><h2>{page.audiencesTitle}</h2></div>
          <p>{page.audiencesLead}</p>
        </div>
        <div class="container audience-grid">
          {page.audiences.map(([category, title, body]) => (
            <article><span>{category}</span><h3>{title}</h3><p>{body}</p></article>
          ))}
        </div>
      </section>
      <section class="section section--accent">
        <div class="container manifesto"><p class="eyebrow">THE CONFERENCE CYCLE</p><h2>{page.modelTitle}</h2><p>{page.modelBody}</p></div>
      </section>
    </>
  )}

  {pageKey === 'departments' && (
    <>
      <section class="page-hero page-hero--departments">
        <div class="container page-hero-grid">
          <div><p class="eyebrow eyebrow--accent">{page.eyebrow}</p><h1>{page.title}</h1></div>
          <p class="page-lead">{page.lead}</p>
        </div>
      </section>
      <section class="section section--paper">
        <div class="container">
          <p class="section-number">I / ORGANIZING FUNCTIONS</p>
          <h2 class="wide-title">{page.unitsTitle}</h2>
          <div class="department-grid">
            {page.units.map(([number, title, body, tags]) => (
              <article>
                <span class="department-number">{number}</span>
                <h3>{title}</h3>
                <p>{body}</p>
                <ul>{tags.map((tag) => <li>{tag}</li>)}</ul>
              </article>
            ))}
          </div>
        </div>
      </section>
      <section class="section section--mist">
        <div class="container information-status">
          <p class="eyebrow">II / STATUS</p>
          <div class="information-status__content">
            <h2>{page.statusTitle}</h2>
            <p>{page.statusBody}</p>
          </div>
        </div>
      </section>
    </>
  )}

  {pageKey === 'application' && (
    <>
      <section class="page-hero">
        <div class="container page-hero-grid"><div><p class="eyebrow eyebrow--accent">{page.eyebrow}</p><h1>{page.title}</h1></div><p class="page-lead">{page.lead}</p></div>
      </section>
      <section class="section section--paper">
        <div class="container"><p class="section-number">01 / PATHS</p><h2 class="wide-title">{page.pathsTitle}</h2>
          <div class="join-grid">
            {page.paths.map(([title, body, status], index) => <article><span>0{index + 1}</span><h3>{title}</h3><p>{body}</p><small>{status}</small></article>)}
          </div>
        </div>
      </section>
      <section class="section section--ink">
        <div class="container process-wrap"><div><p class="eyebrow">02 / PROCESS</p><h2>{page.processTitle}</h2><p>{page.notice}</p></div>
          <ol class="process-list">{page.process.map((item, index) => <li><span>{String(index + 1).padStart(2, '0')}</span>{item}</li>)}</ol>
        </div>
      </section>
    </>
  )}

  {pageKey === 'partners' && (
    <>
      <section class="page-hero page-hero--accent-line">
        <div class="container page-hero-grid"><div><p class="eyebrow eyebrow--accent">{page.eyebrow}</p><h1>{page.title}</h1></div><p class="page-lead">{page.lead}</p></div>
      </section>
      <section class="section section--paper">
        <div class="container"><p class="section-number">01 / COLLABORATE</p><h2 class="wide-title">{page.typesTitle}</h2>
          <div class="partnership-grid">{page.types.map(([title, body], index) => <article><span>0{index + 1}</span><h3>{title}</h3><p>{body}</p></article>)}</div>
        </div>
      </section>
      <section class="section section--accent"><div class="container partner-cta"><div><p class="eyebrow">OPEN CALL</p><h2>{page.ctaTitle}</h2><p>{page.ctaBody}</p></div><a class="button button--dark" href={link('contact')}>{copy.common.partnership}<span aria-hidden="true">↗</span></a></div></section>
    </>
  )}

  {pageKey === 'archive' && (
    <>
      <section class="page-hero">
        <div class="container page-hero-grid"><div><p class="eyebrow eyebrow--accent">{page.eyebrow}</p><h1>{page.title}</h1></div><p class="page-lead">{page.lead}</p></div>
      </section>
      <section class="section section--paper">
        <div class="container archive-browser" data-archive-browser>
          <div class="archive-toolbar">
            <label class="archive-search">
              <span>{archiveCopy.searchLabel}</span>
              <input type="search" placeholder={archiveCopy.searchPlaceholder} data-archive-search />
            </label>
            <div class="archive-filter-wrap">
              <span>{archiveCopy.filterLabel}</span>
              <div class="archive-filters" role="group" aria-label={archiveCopy.filterLabel}>
                <button type="button" data-archive-filter="ALL" aria-pressed="true">{archiveCopy.all}</button>
                {archiveCategories.map((category) => <button type="button" data-archive-filter={category} aria-pressed="false">{category}</button>)}
              </div>
            </div>
          </div>
          <p class="archive-result-count" aria-live="polite" aria-atomic="true"><strong data-archive-count>{archivePosts.length}</strong> {archiveCopy.results}</p>
          <div class="archive-card-list">
            {archivePosts.map((item) => (
              <article
                class="archive-content-card"
                data-archive-card
                data-archive-category={item.category}
                data-archive-search={`${item.category} ${item.title} ${item.subtitle || ''} ${item.venue || ''} ${item.excerpt}`.toLocaleLowerCase()}
              >
                <div class={`archive-card-visual archive-card-visual--${item.category.toLowerCase()} ${item.cover ? 'archive-card-visual--image' : ''}`}>
                  {item.cover && <img src={basePath(item.cover)} alt={item.coverAlt} width="1200" height="675" loading="lazy" />}
                  <div class="archive-card-visual-label" aria-hidden="true">
                    <span>VAN</span>
                    <strong>{item.category}</strong>
                  </div>
                </div>
                <div class="archive-card-content">
                  <div class="archive-card-meta">
                    <span>{item.category}</span>
                    <time datetime={item.date}>{formatArchiveDate(item.date)}</time>
                    <small>{item.status === 'archived' ? archiveCopy.recordStatus : archiveCopy.status}</small>
                  </div>
                  <h2>{item.title}</h2>
                  {item.subtitle && <p class="archive-card-subtitle">{item.subtitle}</p>}
                  <p>{item.excerpt}</p>
                  <a class="archive-read-link" href={link(`archive/${item.slug}`)}>{archiveCopy.read}<span aria-hidden="true">↗</span></a>
                </div>
              </article>
            ))}
          </div>
          <p class="archive-empty" data-archive-empty hidden>{archiveCopy.empty}</p>
        </div>
      </section>
      <script>
        const archiveRoot = document.querySelector('[data-archive-browser]')

        if (archiveRoot instanceof HTMLElement) {
          const archiveInput = archiveRoot.querySelector('[data-archive-search]')
          const archiveCards = [...archiveRoot.querySelectorAll('[data-archive-card]')]
          const archiveButtons = [...archiveRoot.querySelectorAll('[data-archive-filter]')]
          const archiveCount = archiveRoot.querySelector('[data-archive-count]')
          const archiveEmpty = archiveRoot.querySelector('[data-archive-empty]')
          const requestedCategory = new URLSearchParams(window.location.search).get('category')?.toUpperCase()
          let activeCategory = archiveButtons.some((button) => button.getAttribute('data-archive-filter') === requestedCategory)
            ? requestedCategory
            : 'ALL'

          const applyArchiveFilters = () => {
            const query = archiveInput instanceof HTMLInputElement ? archiveInput.value.trim().toLocaleLowerCase() : ''
            let visibleCount = 0

            archiveCards.forEach((card) => {
              if (!(card instanceof HTMLElement)) return
              const matchesCategory = activeCategory === 'ALL' || card.dataset.archiveCategory === activeCategory
              const matchesQuery = !query || (card.dataset.archiveSearch || '').includes(query)
              const isVisible = matchesCategory && matchesQuery
              card.hidden = !isVisible
              if (isVisible) visibleCount += 1
            })

            archiveButtons.forEach((button) => {
              if (!(button instanceof HTMLButtonElement)) return
              button.setAttribute('aria-pressed', String(button.dataset.archiveFilter === activeCategory))
            })

            if (archiveCount) archiveCount.textContent = String(visibleCount)
            if (archiveEmpty instanceof HTMLElement) archiveEmpty.hidden = visibleCount !== 0
          }

          archiveButtons.forEach((button) => {
            button.addEventListener('click', () => {
              if (!(button instanceof HTMLButtonElement)) return
              activeCategory = button.dataset.archiveFilter || 'ALL'
              const url = new URL(window.location.href)
              if (activeCategory === 'ALL') url.searchParams.delete('category')
              else url.searchParams.set('category', activeCategory)
              window.history.replaceState(null, '', url)
              applyArchiveFilters()
            })
          })

          if (archiveInput instanceof HTMLInputElement) archiveInput.addEventListener('input', applyArchiveFilters)
          applyArchiveFilters()
        }
      </script>
    </>
  )}

  {pageKey === 'contact' && (
    <>
      <section class="page-hero page-hero--contact">
        <div class="container page-hero-grid"><div><p class="eyebrow eyebrow--accent">{page.eyebrow}</p><h1>{page.title}</h1></div><p class="page-lead">{page.lead}</p></div>
      </section>
      <section class="section section--paper">
        <div class="container"><p class="section-number">01 / INQUIRIES</p><h2 class="wide-title">{page.topicsTitle}</h2><div class="contact-grid">{page.topics.map(([title, body], index) => <article><span>0{index + 1}</span><h3>{title}</h3><p>{body}</p></article>)}</div></div>
      </section>
      <section class="section section--mist"><div class="container contact-channel"><div><p class="eyebrow">02 / CHANNEL</p><h2>{page.channelTitle}</h2><p>{page.channelBody}</p></div><div class="status-pill"><i aria-hidden="true"></i>{page.channelStatus}</div></div></section>
    </>
  )}
</BaseLayout>
