---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Marquee from '../../components/Marquee.astro'
import { archiveCategories, archiveItems, archiveLabels } from '../../data/activityArchive.js'
import { basePath, content, homeSections, languages, routeBySlug, routeEntries, routePath, sectionNumber } from '../../data/site.js'

export function getStaticPaths() {
  return languages.flatMap((lang) => routeEntries.map(({ slug }) => ({
    params: { lang, slug: slug || undefined },
  })))
}

const lang = Astro.params.lang
const slug = Astro.params.slug || ''
const route = routeBySlug[slug]
const pageKey = route.key
const copy = content[lang]
const page = copy[pageKey]
const [title, description] = copy.meta[pageKey]
const archiveCopy = archiveLabels[lang]
const archivePosts = archiveItems[lang]
const archiveLink = basePath(routePath(lang, 'archive'))
const asset = (path) => basePath(path)

// 우측 스크롤스파이 레일 — HOME 섹션 순서를 그대로 따르고 라벨은 내비게이션과 공유한다.
const railItems = homeSections

// 히어로 금빛 입자. 고정 좌표 — 난수를 쓰면 빌드마다 산출물 diff가 흔들린다.
const heroParticles = [
  { x: 8, y: 78, size: 3, duration: 16, delay: 0 },
  { x: 19, y: 92, size: 2, duration: 19, delay: 2.1 },
  { x: 33, y: 70, size: 4, duration: 14, delay: 4.6 },
  { x: 47, y: 88, size: 2, duration: 18, delay: 1.4 },
  { x: 58, y: 74, size: 3, duration: 15, delay: 6.2 },
  { x: 72, y: 90, size: 2, duration: 20, delay: 3.0 },
  { x: 84, y: 68, size: 4, duration: 13, delay: 5.1 },
  { x: 94, y: 86, size: 2, duration: 17, delay: 7.4 },
]
---

<BaseLayout lang={lang} pageKey={pageKey} slug={slug} title={title} description={description}>
  {pageKey === 'home' && (
    <>
      <nav class="section-rail" data-section-rail hidden aria-label={copy.common.sectionRail}>
        {railItems.map((section) => (
          <a href={`#${section}`} data-rail-target={section}>
            <span>{copy.nav[section]}</span><i aria-hidden="true"></i>
          </a>
        ))}
      </nav>

      <section class="official-hero" data-parallax style={`--hero-image: url('${asset(page.hero.hero)}')`}>
        <div class="official-hero__media" aria-hidden="true"></div>
        <div class="official-hero__veil" aria-hidden="true"></div>
        <div class="official-hero__aurora" aria-hidden="true"></div>
        <div class="official-hero__frame" aria-hidden="true"></div>
        <div class="hero-particles" aria-hidden="true">
          {heroParticles.map((p) => (
            <i style={`--px:${p.x}%; --py:${p.y}%; --ps:${p.size}px; --pd:${p.duration}s; --pl:${p.delay}s`}></i>
          ))}
        </div>
        <div class="container official-hero__content">
          <div class="official-hero__lede">
            <p class="official-hero__kicker">{page.hero.kicker}</p>
            <img class="official-hero__logo" src={asset(page.hero.logoWhite)} alt="VAN · Veritas Academiae Nexus" width="880" height="276" />
            <h1 data-split>{page.hero.title}</h1>
            <p class="official-hero__label">{page.hero.label}</p>
            <p class="official-hero__lead">{page.hero.lead}</p>
          </div>
          <div class="official-hero__meta">
            <ul class="official-hero__schools">
              {page.hero.schools.map((school) => <li>{school}</li>)}
            </ul>
          </div>
        </div>
        <a class="official-hero__scroll" href="#about"><span>{copy.common.scroll}</span><i aria-hidden="true"></i></a>
      </section>

<section id="activities" class="home-section home-section--ink activity-section" data-spotlight>
        <div class="container">
          <header class="section-intro section-intro--light" data-ghost={sectionNumber('activities')} data-reveal="up">
            <div class="section-intro__band">
              <span class="section-number">{sectionNumber('activities')}</span>
              <p>{page.activities.subtitle}</p>
              <i aria-hidden="true"></i>
            </div>
            <h2 data-split>{page.activities.title}</h2>
          </header>
          <p class="section-lead section-lead--light" data-reveal="up">{page.activities.intro}</p>
          <div class="activity-grid" data-reveal-group>
            {page.activities.items.map((item, index) => (
              <article class="activity-card" data-reveal="rise" data-tilt="5">
                <div class="activity-card__media"><img src={asset(item.image)} alt={item.alt} loading="lazy" /></div>
                <div class="activity-card__body" data-index={`0${index + 1}`}><span>0{index + 1}</span><h3>{item.title}</h3><p>{item.summary}</p></div>
              </article>
            ))}
          </div>
          {page.activities.domains && (
            <div class="domain-grid" data-reveal-group>
              {page.activities.domains.map((domain, index) => (
                <article class="domain-card" data-reveal="up">
                  <p class="domain-card__head">
                    <span class="domain-card__index">{String(index + 1).padStart(2, '0')}</span>
                    <strong>{domain.field}</strong>
                    <em>{domain.kr}</em>
                  </p>
                  <ul>{domain.items.map((item) => <li>{item}</li>)}</ul>
                </article>
              ))}
            </div>
          )}

          <a class="inline-link inline-link--light" href={archiveLink} data-reveal="up" data-magnetic="8">{copy.common.archive}<span aria-hidden="true">→</span></a>
        </div>
      </section>

      <Marquee items={copy.ticker} />

      <section id="about" class="home-section home-section--paper">
        <div class="container editorial-layout">
          <header class="section-intro section-intro--sticky" data-ghost={sectionNumber('about')} data-reveal="up">
            <div class="section-intro__band">
              <span class="section-number">{sectionNumber('about')}</span>
              <p>{page.about.subtitle}</p>
              <i aria-hidden="true"></i>
            </div>
            <h2 data-split>{page.about.title}</h2>
          </header>
          <ol class="timeline" data-reveal="fade" data-reveal-group>
            {page.about.paragraphs.map((paragraph, index) => (
              <li data-reveal="up">
                <span class="timeline__node" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <p class:list={{ 'prose-lead': index === 0 }}>{paragraph}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section id="conference" class="conference-spotlight" data-spotlight>
        <div class="container conference-spotlight__grid">
          <div class="conference-spotlight__intro" data-reveal="left">
            <p class="eyebrow">{page.conference.eyebrow}</p>
            <h2 data-split>{page.conference.title}</h2>
            <p class="conference-title-en">{page.conference.englishTitle}</p>
            <p>{page.conference.description}</p>
            <dl>
              {page.conference.facts.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
            </dl>
          </div>
          <div class="conference-spotlight__details">
            <ol class="conference-program" data-reveal-group>
              {page.conference.program.map((item, index) => <li data-reveal="up"><span>0{index + 1}</span>{item}</li>)}
            </ol>
            {page.conference.programNote && (
              <p class="program-note" data-reveal="up">{page.conference.programNote}</p>
            )}
            <div class="session-stack" data-reveal-group>
              {page.conference.sessions.map((session) => (
                <article data-reveal="right"><h3>{session.title}</h3><ul>{session.people.map((person) => <li>{person}</li>)}</ul></article>
              ))}
            </div>
            {page.conference.partners && (
              <div class="partner-strip" data-reveal="up">
                <h3>{page.conference.partnersTitle}</h3>
                <ul>{page.conference.partners.map((name) => <li>{name}</li>)}</ul>
              </div>
            )}
          </div>
        </div>
      </section>

      <Marquee items={copy.ticker} display />

      <section id="leadership" class="home-section home-section--paper">
        <div class="container">
          <header class="section-intro" data-ghost={sectionNumber('leaders')} data-reveal="up">
            <div class="section-intro__band">
              <span class="section-number">{sectionNumber('leaders')}</span>
              <p>{page.leaders.subtitle}</p>
              <i aria-hidden="true"></i>
            </div>
            <h2 data-split>{page.leaders.title}</h2>
          </header>
          <div class="leader-grid" data-reveal-group>
            {page.leaders.items.map((item, index) => (
              <article data-reveal="rise" data-tilt="3" class:list={['profile-card', { 'profile-card--primary': index === 0 }]}>
                {item.image && <img class="profile-card__portrait" src={asset(item.image)} alt={item.name} width="560" height="720" loading="lazy" />}
                <div class="profile-card__body">
                  <p class="profile-card__role">{item.role}</p>
                  <h3>{item.name}</h3>
                  <p class="profile-card__affiliation">{item.affiliation}</p>
                  <ul>{item.careers.map((career) => <li>{career}</li>)}</ul>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="advisory" class="home-section home-section--mist">
        <div class="container">
          <header class="section-intro" data-ghost={sectionNumber('advisory')} data-reveal="up">
            <div class="section-intro__band">
              <span class="section-number">{sectionNumber('advisory')}</span>
              <p>{page.advisory.subtitle}</p>
              <i aria-hidden="true"></i>
            </div>
            <h2 data-split>{page.advisory.title}</h2>
          </header>
          <p class="section-lead section-lead--wide" data-reveal="up">{page.advisory.intro}</p>
          <div class="advisor-grid" data-reveal-group>
            {page.advisory.items.map((item) => (
              <article class="advisor-card" data-reveal="rise">
                {item.image ? <img src={asset(item.image)} alt="" width="150" height="150" loading="lazy" /> : <span class="advisor-card__monogram" aria-hidden="true">VAN</span>}
                <div>
                  <p>{item.role}</p>
                  <h3>{item.name}</h3>
                  {item.affiliation && <strong>{item.affiliation}</strong>}
                  {item.careers.length > 0 && <ul>{item.careers.map((career) => <li>{career}</li>)}</ul>}
                </div>
              </article>
            ))}
          </div>
          <div class="advisor-gallery" data-reveal-group>
            {page.advisory.gallery.map((item) => (
              <figure data-reveal="wipe">
                <img src={asset(item.image)} alt="" loading="lazy" />
                <figcaption>{item.alt}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>

      <section id="people" class="home-section home-section--ink" data-spotlight>
        <div class="container">
          <header class="section-intro section-intro--light" data-ghost={sectionNumber('endorsements')} data-reveal="up">
            <div class="section-intro__band">
              <span class="section-number">{sectionNumber('endorsements')}</span>
              <p>{page.endorsements.subtitle}</p>
              <i aria-hidden="true"></i>
            </div>
            <h2 data-split>{page.endorsements.title}</h2>
          </header>
          <div class="endorsement-grid" data-reveal-group>
            {page.endorsements.items.map((item, index) => (
              <article data-reveal="rise" data-spotlight class:list={['endorsement-card', { 'endorsement-card--featured': index === 0 }]}>
                <div class="person-chip">
                  <img src={asset(item.image)} alt="" width="120" height="120" loading="lazy" />
                  <div><strong>{item.name}</strong><span>{item.role}</span></div>
                </div>
                <blockquote><span aria-hidden="true">“</span>{item.quote}</blockquote>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="future" class="home-section home-section--paper">
        <div class="container">
          <header class="section-intro" data-ghost={sectionNumber('future')} data-reveal="up">
            <div class="section-intro__band">
              <span class="section-number">{sectionNumber('future')}</span>
              <p>{page.future.subtitle}</p>
              <i aria-hidden="true"></i>
            </div>
            <h2 data-split>{page.future.title}</h2>
          </header>
          <div class="roadmap-grid" data-reveal-group>
            {page.future.items.map((item) => (
              <article data-reveal="fade"><span>{item.number}</span><h3>{item.title}</h3><ul>{item.items.map((detail) => <li>{detail}</li>)}</ul></article>
            ))}
          </div>
        </div>
      </section>

      <Marquee items={copy.ticker} reverse />

      <section id="philosophy" class="philosophy-section">
        <div class="container philosophy-section__grid">
          <div data-reveal="left">
            <span class="section-number">{sectionNumber('philosophy')}</span>
            <p class="eyebrow">VERITAS · ACADEMIAE · NEXUS</p>
            <h2 data-split>{page.philosophy.title}</h2>
            <p class="ornament" aria-hidden="true"><i></i><span>◆</span><i></i></p>
            <p>{page.philosophy.body}</p>
          </div>
          <figure data-reveal="wipe"><img src={asset(page.philosophy.image)} alt={page.philosophy.alt} loading="lazy" /></figure>
        </div>
      </section>

      <section id="support" class="home-section home-section--sand">
        <div class="container support-layout">
          <div data-reveal="left">
            <p class="eyebrow">{page.support.subtitle}</p>
            <h2>{page.support.title}</h2>
            <p>{page.support.description}</p>
            <a class="inline-link" href={basePath(routePath(lang, 'support'))} data-magnetic="8">{copy.common.supportDetails}<span aria-hidden="true">→</span></a>
          </div>
          <article class="donation-card" data-reveal="right" data-spotlight data-tilt="5">
            <div class="donation-card__top"><span>{copy.common.donationAccount}</span><i aria-hidden="true"></i></div>
            <dl>
              <div><dt>{copy.common.bank}</dt><dd>{page.support.bank}</dd></div>
              <div><dt>{copy.common.accountNumber}</dt><dd><strong>{page.support.account}</strong><button type="button" data-copy-account={page.support.account} data-copy-label={copy.common.copy} data-copied-label={copy.common.copied}>{copy.common.copy}</button></dd></div>
              <div><dt>{copy.common.holder}</dt><dd>{page.support.holder}</dd></div>
            </dl>
            <div class="donation-card__guide"><p>{page.support.guide}</p><span>{page.support.example}</span></div>
          </article>
        </div>
      </section>

      <section id="contact" class="contact-section">
        <div class="container contact-section__grid">
          <div data-reveal="left"><p class="eyebrow">{page.contact.subtitle}</p><h2>{page.contact.title}</h2></div>
          <div class="contact-list" data-reveal-group>
            <a href={page.contact.instagramUrl} target="_blank" rel="noopener noreferrer" data-reveal="fade"><span>{copy.common.instagram}</span><strong>{page.contact.instagram}</strong></a>
            <div data-reveal="fade"><span>{copy.common.phone}</span><strong>{page.contact.phone}</strong><small>{page.contact.manager}</small></div>
          </div>
        </div>
      </section>

    </>
  )}

  {pageKey === 'archive' && (
    <>
      <section class="archive-hero">
        <div class="container"><p class="eyebrow">{page.eyebrow}</p><h1 data-split>{page.title}</h1><p>{page.lead}</p></div>
      </section>
      <section class="home-section home-section--paper">
        <div class="container archive-browser" data-archive-browser>
          <div class="archive-toolbar" data-reveal="up">
            <label><span>{archiveCopy.searchLabel}</span><input type="search" placeholder={archiveCopy.searchPlaceholder} data-archive-search-input /></label>
            <div><span>{archiveCopy.filterLabel}</span><div class="archive-filters" role="group" aria-label={archiveCopy.filterLabel}>
              <button type="button" data-archive-filter="ALL" aria-pressed="true">{archiveCopy.all}</button>
              {archiveCategories.map((category) => <button type="button" data-archive-filter={category} aria-pressed="false">{category}</button>)}
            </div></div>
          </div>
          <p class="archive-result-count" aria-live="polite"><strong data-archive-count>{archivePosts.length}</strong> {archiveCopy.results}</p>
          <div class="archive-list" data-reveal-group>
            {archivePosts.map((item) => (
              <article
                data-archive-card
                data-reveal="up"
                data-archive-category={item.category}
                data-archive-haystack={`${item.category} ${item.title} ${item.excerpt}`.toLocaleLowerCase()}
              >
                {item.cover ? <img src={asset(item.cover)} alt={item.coverAlt} loading="lazy" /> : <div class="archive-list__mark" aria-hidden="true">VAN</div>}
                <div><p><span>{item.category}</span><small>{archiveCopy.record}</small></p><h2>{item.title}</h2><p>{item.excerpt}</p><a href={basePath(routePath(lang, `archive/${item.slug}`))}>{archiveCopy.read}<span aria-hidden="true">→</span></a></div>
              </article>
            ))}
          </div>
          <p class="archive-empty" data-archive-empty hidden>{archiveCopy.empty}</p>
        </div>
      </section>
    </>
  )}
</BaseLayout>
