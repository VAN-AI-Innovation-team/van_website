---
import { ClientRouter } from 'astro:transitions'
import SiteFooter from '../components/SiteFooter.astro'
import SiteHeader from '../components/SiteHeader.astro'
import { getOrganizationJsonLd, serializeJsonLd } from '../data/organizationJsonLd.js'
import { basePath, content, routePath } from '../data/site.js'
import '../styles/global.css'

const { lang = 'ko', pageKey = 'home', slug = '', title, description, robots = 'index, follow, max-image-preview:large' } = Astro.props
const copy = content[lang]
const alternateLang = lang === 'ko' ? 'en' : 'ko'
const canonicalPath = basePath(routePath(lang, slug))
const alternatePath = basePath(routePath(alternateLang, slug))
const rootPath = basePath(routePath('ko', slug))
const canonical = new URL(canonicalPath, Astro.site)
const alternate = new URL(alternatePath, Astro.site)
const xDefault = new URL(rootPath, Astro.site)
const homeUrl = new URL(basePath('/'), Astro.site)
const socialImage = new URL(basePath('/social-card.svg'), Astro.site)

const organization = await getOrganizationJsonLd({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: lang === 'en' ? 'VAN (Veritas Academiae Nexus)' : 'VAN',
  url: homeUrl.href,
  description: copy.meta.home[1],
  inLanguage: lang === 'en' ? 'en' : 'ko-KR',
}, lang)

const structuredData = [
  organization,
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'VAN',
    url: homeUrl.href,
    inLanguage: ['ko', 'en'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'VAN',
        item: new URL(basePath(routePath(lang)), Astro.site).href,
      },
      ...(pageKey === 'home' ? [] : [{
        '@type': 'ListItem',
        position: 2,
        name: title,
        item: canonical.href,
      }]),
    ],
  },
]

if (pageKey === 'home') {
  structuredData.push({
    '@context': 'https://schema.org',
    '@type': 'Event',
    name: 'VAN Conference 2026',
    description: copy.home.conference.description,
    startDate: '2026-09-12T14:00:00+09:00',
    endDate: '2026-09-12T18:00:00+09:00',
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    eventStatus: 'https://schema.org/EventScheduled',
    location: {
      '@type': 'Place',
      name: lang === 'ko' ? '숙명여자대학교 눈꽃광장홀' : "Snowflake Square Hall, Sookmyung Women's University",
    },
    organizer: { '@type': 'Organization', name: 'VAN', url: homeUrl.href },
    url: `${canonical.href}#conference`,
  })
}

---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b2037" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <title>{title}</title>
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" hreflang={lang} href={canonical.href} />
    <link rel="alternate" hreflang={alternateLang} href={alternate.href} />
    <link rel="alternate" hreflang="x-default" href={xDefault.href} />
    <link rel="icon" type="image/svg+xml" href={basePath('/favicon.svg')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="VAN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={socialImage.href} />
    <meta property="og:locale" content={lang === 'ko' ? 'ko_KR' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Noto+Sans+KR:wght@300;400;500;600;700;800&display=swap"
    />

    <script type="application/ld+json" set:html={serializeJsonLd(structuredData)}></script>

    {/* 페이지 간 이동을 새로고침 없이 부드럽게 이어준다. 미지원 브라우저는 일반 이동으로 동작. */}
    <ClientRouter />

    {/*
      스크롤 리빌 대상은 `.js-ready`가 붙었을 때만 감춰진다.
      인터랙션 스크립트가 끝내 실행되지 않으면 3초 뒤 클래스를 걷어내
      콘텐츠가 영구히 숨는 상황을 막는다.
    */}
    {/*
      이미 배포된 영문 QR·링크 구제용 언어 보정.

      QR 인쇄물 중 일부가 /en/ 주소를 가리켜, 한국어 사용자가 스캔하면 영문
      페이지가 열린다. 인쇄물을 회수할 수 없으므로 진입 시점에 보정한다.

      판정은 referrer 로 나눈다.

      1) referrer 가 비어 있으면 QR 스캔·주소 직접 입력·앱에서 열기다.
         인쇄물의 영문 QR이 정확히 여기 해당하므로, 브라우저 언어를 보지 않고
         한국어로 보낸다. 아이폰 표시 언어가 영어인 경우나 카카오톡·인스타그램
         인앱 브라우저처럼 언어를 en 으로 넘기는 환경까지 함께 구제된다.
      2) referrer 가 외부 사이트면 검색·SNS 유입이다. 영문 사용자일 수 있으므로
         브라우저 우선 언어가 한국어일 때만 보낸다.

      영문 페이지 접근을 막지 않기 위해 아래 경우에는 절대 개입하지 않는다.
        · 사이트 내부에서 넘어온 이동 (referrer 가 같은 오리진)
        · 헤더의 EN 을 직접 누른 세션
        · 주소에 ?lang=en 이 붙은 경우

      head 에서 먼저 실행해 영문 화면이 번쩍 보이는 일을 막고,
      location.replace 로 뒤로가기 히스토리를 더럽히지 않는다.
    */}
    <script is:inline>
      document.addEventListener(
        'click',
        function (event) {
          var target = event.target
          var link = target && target.closest ? target.closest('[data-lang-switch]') : null
          if (!link) return
          try {
            sessionStorage.setItem('van:lang', link.getAttribute('data-lang-switch'))
          } catch (error) {
            /* 프라이빗 모드 등에서 저장이 막히면 referrer 검사로 충분하다 */
          }
        },
        true,
      )

      ;(function () {
        var path = window.location.pathname
        if (path.indexOf('/en/') !== 0) return
        if (window.location.search.indexOf('lang=en') !== -1) return

        try {
          if (sessionStorage.getItem('van:lang') === 'en') return
        } catch (error) {
          /* 저장소를 못 읽어도 아래 검사들로 판단한다 */
        }

        var referrer = document.referrer
        if (referrer && referrer.indexOf(window.location.origin) === 0) return

        // referrer 가 없으면 QR·직접 입력이다. 언어 판정 없이 한국어로 보낸다.
        if (referrer) {
          var list =
            navigator.languages && navigator.languages.length
              ? navigator.languages
              : [navigator.language || '']
          var prefersKorean = false
          for (var i = 0; i < list.length; i += 1) {
            var tag = String(list[i] || '').toLowerCase()
            if (tag.indexOf('ko') === 0) {
              prefersKorean = true
              break
            }
            if (tag.indexOf('en') === 0) break
          }
          if (!prefersKorean) return
        }

        window.location.replace(
          '/ko/' + path.slice(4) + window.location.search + window.location.hash,
        )
      })()
    </script>

    <script is:inline>
      document.documentElement.classList.add('js-ready')
      window.setTimeout(function () {
        if (!document.documentElement.classList.contains('js-booted')) {
          document.documentElement.classList.remove('js-ready')
        }
      }, 3000)
    </script>
  </head>
  <body>
    <div class="scroll-progress" data-scroll-progress role="progressbar" aria-label={copy.common.readingProgress} aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"></div>
    <SiteHeader lang={lang} currentKey={pageKey} currentSlug={slug} />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter lang={lang} />
    <button class="to-top" type="button" data-to-top aria-label={copy.common.toTop}><span aria-hidden="true">↑</span></button>
    <script>
      import '../scripts/interactions.js'
    </script>
  </body>
</html>
