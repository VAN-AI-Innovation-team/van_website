---
import SiteFooter from '../components/SiteFooter.astro'
import SiteHeader from '../components/SiteHeader.astro'
import { basePath, content, routePath } from '../data/conference.js'
import '../styles/global.css'
import '../styles/simple.css'

const {
  lang = 'ko',
  pageKey = 'home',
  navKey = pageKey,
  slug = '',
  title,
  description,
  structuredEvent = null,
  extraStructuredData = [],
  robots = 'index, follow, max-image-preview:large',
  ogType = 'website',
  socialImagePath = '/social-card.png',
  socialImageAlt = 'VAN Conference',
  socialImageWidth = 1200,
  socialImageHeight = 630,
} = Astro.props
const copy = content[lang]
const alternateLang = lang === 'ko' ? 'en' : 'ko'
const canonicalPath = basePath(routePath(lang, slug))
const alternatePath = basePath(routePath(alternateLang, slug))
const rootPath = basePath(routePath('ko', slug))
const canonical = new URL(canonicalPath, Astro.site)
const alternate = new URL(alternatePath, Astro.site)
const xDefault = new URL(rootPath, Astro.site)
const homeUrl = new URL(basePath('/'), Astro.site)
const socialImageSource = socialImagePath.startsWith('/') ? basePath(socialImagePath) : socialImagePath
const socialImage = new URL(socialImageSource, Astro.site)

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'VAN',
    url: homeUrl.href,
    description: copy.meta.home[1],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'VAN',
    url: homeUrl.href,
    inLanguage: ['ko', 'en'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'VAN',
        item: new URL(basePath(routePath(lang)), Astro.site).href,
      },
      ...(pageKey === 'home' ? [] : [{
        '@type': 'ListItem',
        position: 2,
        name: title,
        item: canonical.href,
      }]),
    ],
  },
]

if (
  structuredEvent?.status === 'confirmed'
  && structuredEvent.name
  && structuredEvent.startDate
  && structuredEvent.location?.name
) {
  structuredData.push({
    '@context': 'https://schema.org',
    '@type': 'Event',
    name: structuredEvent.name,
    description,
    url: canonical.href,
    startDate: structuredEvent.startDate,
    ...(structuredEvent.endDate ? { endDate: structuredEvent.endDate } : {}),
    ...(structuredEvent.location ? {
      location: {
        '@type': 'Place',
        name: structuredEvent.location.name,
        ...(structuredEvent.location.address ? { address: structuredEvent.location.address } : {}),
      },
    } : {}),
    eventStatus: 'https://schema.org/EventScheduled',
    organizer: {
      '@type': 'Organization',
      name: 'VAN',
      url: homeUrl.href,
    },
  })
}

if (Array.isArray(extraStructuredData)) {
  structuredData.push(...extraStructuredData.filter(Boolean))
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b2037" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <title>{title}</title>
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" hreflang={lang} href={canonical.href} />
    <link rel="alternate" hreflang={alternateLang} href={alternate.href} />
    <link rel="alternate" hreflang="x-default" href={xDefault.href} />
    <link rel="icon" type="image/svg+xml" href={basePath('/favicon.svg')} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="VAN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={socialImage.href} />
    <meta property="og:image:alt" content={socialImageAlt} />
    {socialImageWidth && <meta property="og:image:width" content={String(socialImageWidth)} />}
    {socialImageHeight && <meta property="og:image:height" content={String(socialImageHeight)} />}
    <meta property="og:locale" content={lang === 'ko' ? 'ko_KR' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'ko' ? 'en_US' : 'ko_KR'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage.href} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replaceAll('<', '\\u003c')}></script>
  </head>
  <body>
    <SiteHeader lang={lang} currentKey={navKey} currentSlug={slug} />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter lang={lang} />
  </body>
</html>
